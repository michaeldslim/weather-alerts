{
  "expo": {
    "name": "Weather Alerts",
    "slug": "weather-alerts",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to show local weather."
      },
      "bundleIdentifier": "com.mike008.weatheralerts"
    },
    "android": {
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#1A365D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mike008.weatheralerts",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "url": "https://u.expo.dev/37fcc02c-dd03-492c-b6be-6d747c106472",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": "1.3.0",
    "extra": {
      "eas": {
        "projectId": "37fcc02c-dd03-492c-b6be-6d747c106472"
      }
    },
    "owner": "mike008"
  }
}
